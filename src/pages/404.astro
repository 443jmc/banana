---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not on this site." canonicalPath="/404">
  <header class="page-hero">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede">The page you were looking for is not here.</p>
      <p><a class="btn btn-solid" href="/">Back to Home</a></p>
    </div>
  </header>
</BaseLayout>
